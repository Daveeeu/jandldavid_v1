APP_NAME="Jandl Dávid"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://jandldavid.hu

APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu
APP_FAKER_LOCALE=hu_HU

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/database.sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.jandldavid.hu

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@jandldavid.hu
MAIL_FROM_NAME="Jandl Dávid"
CONTACT_NOTIFICATION_EMAIL=david@jandldavid.hu
CONTACT_NOTIFICATION_NAME="Jandl Dávid"

VITE_APP_NAME="${APP_NAME}"
VITE_GTM_CONTAINER_ID=
VITE_GA4_MEASUREMENT_ID=
GA4_API_SECRET=
SEARCH_CONSOLE_VERIFICATION=
POSTHOG_ENABLED=false
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_PROJECT_KEY=
PLAUSIBLE_ENABLED=false
PLAUSIBLE_DOMAIN=
PLAUSIBLE_HOST=https://plausible.io
PLAUSIBLE_SCRIPT_SRC=
ADMIN_DASHBOARD_ENABLED=true
ADMIN_DASHBOARD_TOKEN=
ANALYTICS_REPORT_ENABLED=true
